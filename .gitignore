# Rust build artifacts
/target

# insta pending snapshots (review + accept, don't commit the .new files)
*.snap.new

# Reference PHP source / parse corpus (~870 MB, a checkout of php/php-src).
# Not vendored into this repo — obtain separately and place at ./php-src.
# Used only by dev tooling (`xtask corpus`/`difftokens`/`gen-tokens`); the
# committed golden fixtures under test-fixtures/ make the test suite self-contained.
/php-src

# phpstan reference source (a shallow checkout of phpstan/phpstan-src @ 2.2.x).
# Spec oracle for replicating phpstan's rules + level mapping (conf/config.level*.neon,
# src/Rules/**). Not vendored — obtain via `git clone --depth 1 --branch 2.2.x
# https://github.com/phpstan/phpstan-src.git phpstan-src`.
/phpstan-src

# JetBrains IDE
/.idea

# macOS Finder metadata
.DS_Store

# phpxray's own on-disk caches (created in any analyzed project root, incl. this one)
/.phpxray
/.php-analyzer

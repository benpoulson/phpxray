---
source: crates/php-parser/tests/expr_snapshots.rs
expression: "matrix(&[\"1 + 2 * 3\", \"1 * 2 + 3\", \"2 ** 3 ** 2\", \"-2 ** 2\", \"1 - 2 - 3\",\n\"1 . 2 . 3\", \"1 << 2 + 3\", \"$a = $b = $c\", \"$a = $b + 1\", \"$a == $b && $c\",\n\"$a && $b || $c\", \"$a ?? $b ?? $c\", \"$a ? $b : $c\", \"$a ? $b : $c ? $d : $e\",\n\"$a ?: $b\", \"!$a && $b\", \"$a instanceof B && $c\", \"$a + $b <=> $c - $d\",\n\"$x = $a or $b\", \"print $a + 1\",])"
---
1 + 2 * 3                      => (+ 1 (* 2 3))
1 * 2 + 3                      => (+ (* 1 2) 3)
2 ** 3 ** 2                    => (** 2 (** 3 2))
-2 ** 2                        => (u- (** 2 2))
1 - 2 - 3                      => (- (- 1 2) 3)
1 . 2 . 3                      => (. (. 1 2) 3)
1 << 2 + 3                     => (<< 1 (+ 2 3))
$a = $b = $c                   => (= $a (= $b $c))
$a = $b + 1                    => (= $a (+ $b 1))
$a == $b && $c                 => (&& (== $a $b) $c)
$a && $b || $c                 => (|| (&& $a $b) $c)
$a ?? $b ?? $c                 => (?? $a (?? $b $c))
$a ? $b : $c                   => (?: $a $b $c)
$a ? $b : $c ? $d : $e         => (?: (?: $a $b $c) $d $e)
$a ?: $b                       => (?: $a $b)
!$a && $b                      => (&& (! $a) $b)
$a instanceof B && $c          => (&& (instanceof $a B) $c)
$a + $b <=> $c - $d            => (<=> (+ $a $b) (- $c $d))
$x = $a or $b                  => (or (= $x $a) $b)
print $a + 1                   => (print (+ $a 1))
